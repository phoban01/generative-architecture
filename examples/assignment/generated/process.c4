specification { element assignmentStep }
model {
 mac_step0 = assignmentStep "return \"assigned\"" { description "return" }
 mac_step1 = assignmentStep "store.UpdateInfraMachineStatus(machineID)" { description "publish" }
 mac_step2 = assignmentStep "return \"waiting\"" { description "return" }
 mac_step3 = assignmentStep "machineID == \"\"" { description "branch" }
 mac_step4 = assignmentStep "return \"waiting\"" { description "return" }
 mac_step5 = assignmentStep "store.CreateMachineClaim()" { description "createClaim" }
 mac_step6 = assignmentStep "!claimFound" { description "branch" }
 mac_step7 = assignmentStep "claimFound, machineID := store.MachineClaim()" { description "readClaim" }
 mac_step8 = assignmentStep "return \"unsupported\"" { description "return" }
 mac_step9 = assignmentStep "!compatible" { description "branch" }
 mac_step10 = assignmentStep "compatible := store.SatisfiesMachineAssignmentContract()" { description "checkContract" }
 mac_step11 = assignmentStep "return \"absent\"" { description "return" }
 mac_step12 = assignmentStep "!found" { description "branch" }
 mac_step13 = assignmentStep "found := store.InfraMachineExists()" { description "readInfra" }
 mac_step1 -> mac_step0 "next"
 mac_step3 -> mac_step2 "true"
 mac_step3 -> mac_step1 "false"
 mac_step5 -> mac_step4 "next"
 mac_step6 -> mac_step5 "true"
 mac_step6 -> mac_step3 "false"
 mac_step7 -> mac_step6 "next"
 mac_step9 -> mac_step8 "true"
 mac_step9 -> mac_step7 "false"
 mac_step10 -> mac_step9 "next"
 mac_step12 -> mac_step11 "true"
 mac_step12 -> mac_step10 "false"
 mac_step13 -> mac_step12 "next"
}
views { view mac_assignment_flow { title "MAC: extracted reconcile flow"
 include mac_step0, mac_step1, mac_step2, mac_step3, mac_step4, mac_step5, mac_step6, mac_step7, mac_step8, mac_step9, mac_step10, mac_step11, mac_step12, mac_step13
 } }
