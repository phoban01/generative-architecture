specification { element dynamicClientPart }
model {
 dynamic_client = dynamicClientPart "Dynamic Kubernetes client"
 dynamic_resource0 = dynamicClientPart "MachineClaim" { description "demo.architecture.local/v1alpha1, Resource=machineclaims; Namespaced" }
 dynamic_client -> dynamic_resource0 "CreateMachineClaim: create via s.ClaimResource"
 dynamic_resource1 = dynamicClientPart "InfraMachine" { description "demo.architecture.local/v1alpha1, Resource=inframachines; Namespaced" }
 dynamic_client -> dynamic_resource1 "InfraMachineExists: get via s.InfraResource"
 dynamic_client -> dynamic_resource0 "MachineClaim: get via s.ClaimResource"
 dynamic_client -> dynamic_resource1 "UpdateInfraMachineStatus: status.update via s.InfraResource"
}
views { view dynamic_client_access { title "Dynamic resource access extracted from Go"
 include dynamic_client, dynamic_resource0, dynamic_resource1
 } }
