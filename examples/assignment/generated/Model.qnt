// Generated from a typed TransitionModel; declared semantics, not inferred intent.
module AssignmentWalkthrough {
 var claimCreates: int
 var claimEvent: str
 var claimExists: bool
 var claimFound: bool
 var claimMachineId: str
 var claimUpdatePending: bool
 var compatible: bool
 var contractSatisfied: bool
 var finished: bool
 var found: bool
 var infraEvent: str
 var infraExists: bool
 var invocations: int
 var machineID: str
 var outcome: str
 var pc: int
 var queued: bool
 var statusMachineId: str
 var wrongKey: bool
 var event: str
 action init = all { event' = "init", claimCreates' = 0, claimEvent' = "", claimExists' = false, claimFound' = false, claimMachineId' = "", claimUpdatePending' = false, compatible' = false, contractSatisfied' = false, finished' = true, found' = false, infraEvent' = "", infraExists' = false, invocations' = 0, machineID' = "", outcome' = "", pc' = -1, queued' = false, statusMachineId' = "", wrongKey' = false }
 action discoverCompatible = all { (not(infraExists) and (invocations == 0)), event' = "discoverCompatible", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = true, finished' = finished, found' = found, infraEvent' = "create", infraExists' = true, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = pc, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action discoverUnsupported = all { (not(infraExists) and (invocations == 0)), event' = "discoverUnsupported", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = false, finished' = finished, found' = found, infraEvent' = "create", infraExists' = true, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = pc, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action fulfillClaim = all { (claimExists and (claimMachineId == "")), event' = "fulfillClaim", claimCreates' = claimCreates, claimEvent' = (if ((claimEvent == "create")) "create" else "update"), claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = "machine-1", claimUpdatePending' = ((claimEvent == "create") or claimUpdatePending), compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = pc, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action idle = all { finished, event' = "idle", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = pc, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node0_return = all { ((not(finished) and (pc == 0)) and true), event' = "node0_return", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = true, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = "assigned", pc' = -1, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node1_publish = all { ((not(finished) and (pc == 1)) and true), event' = "node1_publish", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = "update", infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = 0, queued' = queued, statusMachineId' = machineID, wrongKey' = wrongKey }
 action node2_return = all { ((not(finished) and (pc == 2)) and true), event' = "node2_return", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = true, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = "waiting", pc' = -1, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node3_branch = all { ((not(finished) and (pc == 3)) and true), event' = "node3_branch", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = (if ((machineID == "")) 2 else 1), queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node4_return = all { ((not(finished) and (pc == 4)) and true), event' = "node4_return", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = true, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = "waiting", pc' = -1, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node5_createClaim = all { ((not(finished) and (pc == 5)) and true), event' = "node5_createClaim", claimCreates' = (claimCreates + 1), claimEvent' = "create", claimExists' = true, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = 4, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node6_branch = all { ((not(finished) and (pc == 6)) and true), event' = "node6_branch", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = (if (not(claimFound)) 5 else 3), queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node7_readClaim = all { ((not(finished) and (pc == 7)) and true), event' = "node7_readClaim", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimExists, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = claimMachineId, outcome' = outcome, pc' = 6, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node8_return = all { ((not(finished) and (pc == 8)) and true), event' = "node8_return", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = true, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = "unsupported", pc' = -1, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node9_branch = all { ((not(finished) and (pc == 9)) and true), event' = "node9_branch", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = (if (not(compatible)) 8 else 7), queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node10_checkContract = all { ((not(finished) and (pc == 10)) and true), event' = "node10_checkContract", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = contractSatisfied, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = 9, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node11_return = all { ((not(finished) and (pc == 11)) and true), event' = "node11_return", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = true, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = "absent", pc' = -1, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node12_branch = all { ((not(finished) and (pc == 12)) and true), event' = "node12_branch", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = (if (not(found)) 11 else 10), queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action node13_readInfra = all { ((not(finished) and (pc == 13)) and true), event' = "node13_readInfra", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = infraExists, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = 12, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action reconcile = all { ((finished and queued) and (invocations < 4)), event' = "reconcile", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = false, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = false, contractSatisfied' = contractSatisfied, finished' = false, found' = false, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = (invocations + 1), machineID' = "", outcome' = "", pc' = 13, queued' = false, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action deliverInfra = all { (infraEvent != ""), event' = "deliverInfra", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = "", infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = pc, queued' = (queued or true), statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action deliverClaim = all { (claimEvent != ""), event' = "deliverClaim", claimCreates' = claimCreates, claimEvent' = (if (((claimEvent == "create") and claimUpdatePending)) "update" else ""), claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = false, compatible' = compatible, contractSatisfied' = contractSatisfied, finished' = finished, found' = found, infraEvent' = infraEvent, infraExists' = infraExists, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = pc, queued' = (queued or true), statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action removeInfraBeforeRead = all { ((infraExists and not(claimExists)) and (invocations == 0)), event' = "removeInfraBeforeRead", claimCreates' = claimCreates, claimEvent' = claimEvent, claimExists' = claimExists, claimFound' = claimFound, claimMachineId' = claimMachineId, claimUpdatePending' = claimUpdatePending, compatible' = compatible, contractSatisfied' = false, finished' = finished, found' = found, infraEvent' = "delete", infraExists' = false, invocations' = invocations, machineID' = machineID, outcome' = outcome, pc' = pc, queued' = queued, statusMachineId' = statusMachineId, wrongKey' = wrongKey }
 action step = any { discoverCompatible, discoverUnsupported, fulfillClaim, idle, node0_return, node1_publish, node2_return, node3_branch, node4_return, node5_createClaim, node6_branch, node7_readClaim, node8_return, node9_branch, node10_checkContract, node11_return, node12_branch, node13_readInfra, reconcile, deliverInfra, deliverClaim, removeInfraBeforeRead }
 val claimsRequireCompatibleInfra = (not(claimExists) or (infraExists and contractSatisfied))
 val atMostOneClaim = (claimCreates <= 1)
 val publicationRequiresFulfilledClaim = ((statusMachineId == "") or ((claimExists and (claimMachineId != "")) and (statusMachineId == claimMachineId)))
 val waitingHasAClaim = ((outcome != "waiting") or claimExists)
 val assignedHasMachineId = ((outcome != "assigned") or (statusMachineId != ""))
 val infraWatchEnqueuesMAC = ((event != "deliverInfra") or queued)
 val claimFulfillmentEnqueuesMAC = (((event != "deliverClaim") or (claimMachineId == "")) or queued)
 val watchTargetsInfraMachine = not(wrongKey)
 val safety = claimsRequireCompatibleInfra and atMostOneClaim and publicationRequiresFulfilledClaim and waitingHasAClaim and assignedHasMachineId and infraWatchEnqueuesMAC and claimFulfillmentEnqueuesMAC and watchTargetsInfraMachine
}
