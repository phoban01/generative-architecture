specification { element assignmentWatchPart }
model {
 mac_watch_queue = assignmentWatchPart "MAC workqueue"
 mac_watch_reconcile = assignmentWatchPart "MAC reconcile"
 mac_watch_queue -> mac_watch_reconcile "dequeue InfraMachine key"
 mac_watch_source0 = assignmentWatchPart "InfraMachine events"
