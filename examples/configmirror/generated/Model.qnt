 val exclusive = (not((ready and processing)) and (not(ready) or dirty))
 val capacity = ((if (processing) 1 else 0) <= 1)
 val queueSafety = (not((ready and processing)) and (not(ready) or dirty))
 val writesObservedValue = ((event != "writeTarget_ok") or (ConfigMap_copy_data_value == snapshot))
 val boundedRetries = ((retries >= 0) and (retries <= 3))
 val safety = exclusive and capacity and queueSafety and writesObservedValue and boundedRetries
}
